var HOLE golf::Hole
var ST Style
var GZ real = 0.0
var BALL int = -1
var BALLQ = linalg::quat_identity()
var LASTX real = 0.0
var LASTY real = 0.0
var ROLLED = false
var DOTS int[30] = [-1; 30]
var ARROW int = -1
var PUTTER int = -1
var FLAG int[4] = [-1; 4]
var FLAG_X real = 0.0
var FLAG_Y real = 0.0
var FLAG_Z real = 0.0
var MVI int[>..] = []
var LAVA_IT int = -1
var BOUNCE_IT int = -1
var GLOW_IT int = -1
var NEON_IT int = -1
var M_TURF gltf::Material
