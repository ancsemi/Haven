namespace pool_ai
use pool
use math
struct Plan { angle real, power real, sx real, sy real, place bool, px real, py real, score real }
struct Cand { target int, pocket int, angle real, cut real, base real }
aim_point(k int) real, real:
	p := pool::POCKETS[k]
	d := sqrt(p.x * p.x + p.y * p.y)
	f := if p.side { 0.015 } else { 0.03 }
	if d < 0.000000001: return p.x, p.y
	return p.x - p.x / d * f, p.y - p.y / d * f
clear_path(balls pool::Ball[:], ax real, ay real, bx real, by real, skip1 int, skip2 int) bool:
	dx := bx - ax
	dy := by - ay
	l2 := dx * dx + dy * dy
	lim := 1.98 * pool::R
	for i balls.len:
		if i == skip1 || i == skip2 || !balls[i].on: continue
		t ~= 0.0
		if l2 > 0.0:
			t = clamp(((balls[i].x - ax) * dx + (balls[i].y - ay) * dy) / l2, 0.0, 1.0)
		qx := ax + t * dx - balls[i].x
		qy := ay + t * dy - balls[i].y
		if qx * qx + qy * qy < lim * lim: return false
	true
legal_now(g pool::Game&, num int) bool:
	if pool::cleared(g, g.turn): return num == 8
	if !g.broke: return num != 8
	pool::owns(g, g.turn, num)
cands(g pool::Game&, cx real, cy real, out Cand[>..]&):
	out.clear()
	for t 1..g.balls.len:
		b := g.balls[t]
		if !b.on: continue
		legal := legal_now(g, b.num)
		if !legal: continue
		for k pool::POCKETS.len:
			ax, ay := aim_point(k)
			dx := ax - b.x
			dy := ay - b.y
			dl := sqrt(dx * dx + dy * dy)
			if dl < 0.000000001: continue
			ux := dx / dl
			uy := dy / dl
			gx := b.x - 2.0 * pool::R * ux
			gy := b.y - 2.0 * pool::R * uy
			hx := gx - cx
			hy := gy - cy
			hl := sqrt(hx * hx + hy * hy)
			if hl < 0.000000001: continue
			cut := (hx / hl) * ux + (hy / hl) * uy
			if cut <= 0.2: continue
			if abs(gx) > pool::HL - pool::R || abs(gy) > pool::HW - pool::R: continue
			if !clear_path(g.balls, cx, cy, gx, gy, 0, t): continue
			if !clear_path(g.balls, b.x, b.y, ax, ay, 0, t): continue
			base ~= cut * cut / (1.0 + hl + 1.5 * dl)
			if pool::POCKETS[k].side && abs(ux) > 0.6:
				base *= 0.7
			out.push(Cand{target: t, pocket: k, angle: atan2(hy, hx), cut: cut, base: base});
pot_power(g pool::Game&, c Cand, cx real, cy real) real:
	b := g.balls[c.target]
	ax, ay := aim_point(c.pocket)
	dx := ax - b.x
	dy := ay - b.y
	dd := sqrt(dx * dx + dy * dy)
	ux := if dd > 0.000000001 { dx / dd } else { 0.0 }
	uy := if dd > 0.000000001 { dy / dd } else { 0.0 }
	gx := b.x - 2.0 * pool::R * ux
	gy := b.y - 2.0 * pool::R * uy
	hx := gx - cx
	hy := gy - cy
	hl := sqrt(hx * hx + hy * hy)
	ts := sqrt(0.16 + 2.0 * pool::MU_R * pool::GRAV * dd * 1.6)
	cs := ts / (0.975 * max(c.cut, 0.3)) + 1.2 * pool::MU_R * pool::GRAV * hl
	clamp((cs - 0.35) / (pool::MAX_SPEED - 0.35), 0.05, 0.95)
outcome(g pool::Game&, p Plan) real:
	c ~= copy(g)
	if p.place: pool::place_cue(c, p.px, p.py)
	pool::begin_shot(c)
	pool::strike(c.balls, p.angle, p.power, p.sx, p.sy)
	s ~= pool::Shot{first: -1, ..}
	pool::simulate(c.balls, s)
	pool::end_shot(c, s, "a", "b")
	if c.over:
		if c.winner == g.turn: return 1000.0
		return -1000.0
	if c.foul: return -150.0
	cs Cand[>..] ~= []
	cands(c, c.balls[0].x, c.balls[0].y, cs)
	n := min(cs.len, 5)
	if c.turn == g.turn:
		best ~= 0.0
		for q cs:
			best = max(best, q.base)
		return 100.0 + 12.0 * n + best * 40.0
	return -10.0 * n
spot(g pool::Game&, level int, seed int) real, real:
	st ~= seed
	if !g.broke: return pool::HEAD_X, 0.12 * (pool::rng(st) - 0.5)
	x0 := -pool::HL + 0.1
	x1 := if g.kitchen { pool::HEAD_X } else { pool::HL - 0.1 }
	y0 := -pool::HW + 0.1
	y1 := pool::HW - 0.1
	xs real[>..] ~= []
	ys real[>..] ~= []
	bs real[>..] ~= []
	cs Cand[>..] ~= []
	nx ~= pool::HEAD_X
	ny ~= 0.0
	nd ~= 1000000000.0
	for i 15:
		x := x0 + (x1 - x0) * i / 14
		for j 7:
			y := y0 + (y1 - y0) * j / 6
			if !pool::can_place(g, x, y): continue
			d := x * x + y * y
			if d < nd:
				nd = d
				nx = x
				ny = y
			cands(g, x, y, cs)
			if cs.len > 0:
				best ~= 0.0
				for q cs:
					best = max(best, q.base)
				xs.push(x)
				ys.push(y)
				bs.push(best)
	if xs.len == 0: return nx, ny
	if level == 0:
		idx int[>..] ~= []
		for i xs.len:
			idx.push(i)
		sort(idx) { a, b => bs[a] > bs[b] }
		half := (idx.len + 1) / 2
		k := clamp((pool::rng(st) * half) as int, 0, half - 1)
		return xs[idx[k]], ys[idx[k]]
	bi ~= 0
	for i xs.len:
		if bs[i] > bs[bi]:
			bi = i
	return xs[bi], ys[bi]
safety(g pool::Game&) Plan:
	cb := g.balls[0]
	tx ~= pool::FOOT_X
	ty ~= 0.0
	bd ~= 1000000000.0
	for t 1..g.balls.len:
		b := g.balls[t]
		if !b.on || !legal_now(g, b.num): continue
		d := (b.x - cb.x) * (b.x - cb.x) + (b.y - cb.y) * (b.y - cb.y)
		if d < bd:
			bd = d
			tx = b.x
			ty = b.y
	Plan{angle: atan2(ty - cb.y, tx - cb.x), power: 0.22, sx: 0.0, sy: 0.0, place: false, px: 0.0, py: 0.0, score: 0.0}
struct Search { best int, best_score real, next int, fixed bool, plans Plan[>..] }
start(g pool::Game&, level int, seed int) Search:
	sr ~= Search{best: -1, ..}
	if !g.broke:
		x, y := spot(g, level, seed)
		pw := if level == 2 { 1.0 } else if level == 1 { 0.95 } else { 0.8 }
		sr.plans.push(Plan{angle: atan2(0.0 - y, pool::FOOT_X - x), power: pw, sx: 0.0, sy: 0.0, place: true, px: x, py: y, score: 0.0})
		sr.fixed = true
		return sr
	cx ~= g.balls[0].x
	cy ~= g.balls[0].y
	pl ~= false
	ppx ~= 0.0
	ppy ~= 0.0
	if g.in_hand:
		qx, qy := spot(g, level, seed)
		pl = true
		ppx = qx
		ppy = qy
		cx = qx
		cy = qy
	cs Cand[>..] ~= []
	cands(g, cx, cy, cs)
	if cs.len == 0:
		sf ~= Plan{angle: 0.0, power: 0.5, sx: 0.0, sy: 0.0, place: false, px: 0.0, py: 0.0, score: 0.0}
		if pl:
			h ~= copy(g)
			pool::place_cue(h, ppx, ppy)
			sf = safety(h)
			sf.place = true
			sf.px = ppx
			sf.py = ppy
		else:
			sf = safety(g)
		sr.plans.push(sf)
		sr.fixed = true
		return sr
	sort(cs) { a, b => a.base > b.base }
	lim := if level == 0 { 3 } else if level == 1 { 6 } else { 9 }
	nc := min(cs.len, lim)
	fs real[>..] ~= []
	sys real[>..] ~= []
	if level == 0:
		fs.push(1.0)
		sys.push(0.0)
	else if level == 1:
		fs.push(0.9)
		fs.push(1.15)
		sys.push(0.0)
		sys.push(0.3)
		sys.push(-0.3)
	else:
		fs.push(0.85)
		fs.push(1.0)
		fs.push(1.2)
		sys.push(0.0)
		sys.push(0.35)
		sys.push(-0.35)
	for i nc:
		c := cs[i]
		bp := pot_power(g, c, cx, cy)
		sxs real[>..] ~= []
		sxs.push(0.0)
		if level == 2 && i < 3:
			sxs.push(0.25)
			sxs.push(-0.25)
		for f fs:
			for sy sys:
				for sx sxs:
					sr.plans.push(Plan{angle: c.angle, power: clamp(bp * f, 0.05, 1.0), sx: sx, sy: sy, place: pl, px: ppx, py: ppy, score: 0.0})
	sr
work(sr Search&, g pool::Game&, budget int) bool:
	if sr.fixed: return true
	n ~= 0
	while n < budget && sr.next < sr.plans.len:
		sc := outcome(g, sr.plans[sr.next])
		if sr.best < 0 || sc > sr.best_score:
			sr.best = sr.next
			sr.best_score = sc
		sr.next += 1
		n += 1
	sr.next >= sr.plans.len
finish(sr Search&, level int, seed int) Plan:
	st ~= seed + 7
	i := if sr.fixed || sr.best < 0 { 0 } else { sr.best }
	p ~= sr.plans[i]
	na := if level == 0 { 0.035 } else if level == 1 { 0.012 } else { 0.0035 }
	np := if level == 0 { 0.06 } else if level == 1 { 0.035 } else { 0.015 }
	n1 := pool::rng(st) + pool::rng(st) + pool::rng(st) - 1.5
	p.angle += n1 * na
	n2 := pool::rng(st) + pool::rng(st) + pool::rng(st) - 1.5
	p.power = clamp(p.power * (1.0 + n2 * np), 0.03, 1.0)
	p
think(g pool::Game&, level int, seed int) Plan:
	sr ~= start(g, level, seed)
	work(sr, g, 100000)
	finish(sr, level, seed)
